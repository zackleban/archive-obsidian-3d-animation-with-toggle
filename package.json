{
	"name": "obsidian-3d-animation-with-toggle",
	"version": "1.2.1",
	"description": "Explore your notes as a 3D graph, switch between 2D and 3D, and animate vault growth by creation date with colored folder clusters.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src package.json --max-warnings 0",
		"test": "node --test tests/*.test.mjs",
		"qa": "npm run lint && npm test && npm run build && node scripts/check-package.mjs"
	},
	"license": "MIT",
	"dependencies": {
		"d3-force-3d": "3.0.6",
		"three": "0.186.1"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/three": "0.186.0",
		"esbuild": "0.28.2",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"jsdom": "^30.1.3",
		"obsidian": "1.14.4",
		"typescript": "~5.9.0",
		"typescript-eslint": "^8.72.1"
	}
}
